<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 by default, stretchable either way. Never refreshed on a timer: the app
     pushes a new summary at the end of every background pass, so a timer would
     only spend battery repainting the same thing. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_positions"
    android:previewLayout="@layout/widget_positions"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_positions_desc" />
