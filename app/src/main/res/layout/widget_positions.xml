<?xml version="1.0" encoding="utf-8"?>
<!-- THE POSITIONS WIDGET: what is held, near a stop, a target or its high —
     the same summary the background pass builds, always fully visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_positions_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wp_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Positions"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/wp_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:singleLine="true" />

        <!-- REFRESH NOW: re-reads the positions and prices instead of waiting for
             the next 15-minute pass. Large enough to hit with a thumb. -->
        <TextView
            android:id="@+id/wp_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="↻"
            android:textColor="#E6FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:contentDescription="Refresh now" />
    </LinearLayout>

    <TextView
        android:id="@+id/wp_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- THE MARKETS TODAY: DAX, Sensex and Nasdaq-100 — the day's change and a
         tiny line of the session, dashed at the previous close. -->
    <LinearLayout
        android:id="@+id/wp_indices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wp_ix0_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:singleLine="true" />
            <ImageView
                android:id="@+id/wp_ix0_img"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:scaleType="fitXY"
                android:contentDescription="DAX today" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wp_ix1_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:singleLine="true" />
            <ImageView
                android:id="@+id/wp_ix1_img"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:scaleType="fitXY"
                android:contentDescription="Sensex today" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wp_ix2_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:singleLine="true" />
            <ImageView
                android:id="@+id/wp_ix2_img"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:scaleType="fitXY"
                android:contentDescription="Nasdaq-100 today" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/wp_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/wp_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
